# ============================================
# Moonevue Monorepo - Root Environment Template
# ============================================

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=
# Para modo standalone (frontend no host, backend no Docker):
# INTERNAL_API_BASE_URL=http://localhost:8080
# AUTH_INTERNAL_API_BASE_URL=http://localhost:8081
# FINANCE_INTERNAL_API_BASE_URL=http://localhost:8082

# ---------- Shared timezone ----------
TZ=America/Sao_Paulo

# ---------- PostgreSQL ----------
POSTGRES_DB=moonevue
POSTGRES_USER=moonevue
POSTGRES_PASSWORD=change-me

# ---------- Spring datasource ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/moonevue
SPRING_DATASOURCE_USERNAME=moonevue
SPRING_DATASOURCE_PASSWORD=change-me

# ---------- Auth / Internal ----------
AUTH_BASE_URL=http://auth:8081
AUTH_INTERNAL_TOKEN=change-me-internal-token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_NAME=sid
AUTH_COOKIE_MAX_AGE=1800

# ---------- Storage ----------
STORAGE_CERTS_DIR=/data/certs

# ---------- Webhooks ----------
WEBHOOK_HMAC_SECRET=change-me-webhook-secret
ASAAS_WEBHOOK_TOKEN=change-me-asaas-webhook-token
ASAAS_WEBHOOK_HEADER=asaas-access-token

# ---------- API pública (integrações) ----------
# Pepper usado no HMAC do segredo das API Keys. Gere um valor forte e mantenha em segredo.
# A rotação deste valor invalida todas as API Keys existentes.
API_KEY_PEPPER=change-me-api-key-pepper
# Limite de requisições por minuto, por API Key, na API pública.
API_KEY_RATE_LIMIT_PER_MINUTE=120
